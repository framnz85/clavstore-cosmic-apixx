SUPER_DATABASE=mongodb://127.0.0.1:27017/cosmic_scanner_super_local_test?directConnection=true
REDIS_URL=redis://127.0.0.1:6381
SCANNER_DEVELOPMENT_STORE_ID=6aea21f9b2f055c904c7ba16
MULTI_SCAN_ENABLED=false
